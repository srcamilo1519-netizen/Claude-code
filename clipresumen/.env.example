# ─────────────────────────────────────────────────────────────
# ClipResumen — Environment variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Used by the backend (SQLAlchemy) to connect to Postgres.
# When running with docker-compose, the host is the service name `postgres`.
POSTGRES_USER=clipresumen
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clipresumen
DATABASE_URL=postgresql+psycopg2://clipresumen:changeme@postgres:5432/clipresumen

# ── Anthropic / Claude API ────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Auth (JWT) ────────────────────────────────────────────────
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Backend ───────────────────────────────────────────────────
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=3000
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base URL the frontend's server-side Route Handlers use to reach the backend.
# Inside docker-compose this is the backend service name.
BACKEND_URL=http://backend:8000

# ── Stripe (Fase 6) ───────────────────────────────────────────
# Usa claves de TEST mientras desarrollas; reemplázalas por las LIVE en prod.
# STRIPE_SECRET_KEY:     sk_test_… (dashboard.stripe.com/test/apikeys)
# STRIPE_WEBHOOK_SECRET: whsec_…   (al crear el endpoint de webhook o con `stripe listen`)
# STRIPE_PRICE_*:        price_…   (id del precio recurrente de cada plan)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# URL pública del frontend para los redirects de checkout/portal de Stripe.
FRONTEND_BASE_URL=http://localhost:3000

# ── Producción / VPS (Fase 7) ─────────────────────────────────
# Dominio que apunta al VPS (sin https://). Usado por Nginx y Certbot.
DOMAIN=tu-dominio.com
# Email para los avisos de Let's Encrypt.
CERTBOT_EMAIL=tu-email@ejemplo.com
# Pon 1 para usar el entorno de staging de Let's Encrypt mientras pruebas.
CERTBOT_STAGING=0
# Backups: días de retención local y, opcionalmente, destino rclone externo.
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=
# Monitoreo (Grafana).
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave
